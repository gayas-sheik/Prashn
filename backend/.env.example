# Prashn Backend Environment Configuration
# Do not place real secrets, keys, or passwords in this file.

PORT=5000
# The port the backend will run on

JWT_SECRET=
# Required: Secret key for signing JWT tokens. 
# Example: a-secure-random-string

DB_FILE=./data/development/prashn.db
# Paths resolve relative to backend/, regardless of the shell working directory.
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed

NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
PROCESSING_CONCURRENCY=2
MAX_DOCUMENT_PAGES=100
OCR_LANGUAGE=eng
# English trained data is bundled. Supply a local data directory for other languages.
OCR_LANG_PATH=
# auto: native PDF text plus OCR for scanned pages; always: OCR every PDF page.
OCR_MODE=auto

# Keep empty for the current lightweight, document-grounded Q&A mode.
# No model installation or external inference service is required.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434

# Optional AWS mode: set ALL three together after provisioning the resources.
# STORAGE_MODE=s3
# DATABASE_MODE=dynamodb
# PROCESSING_MODE=sqs
# AWS_REGION=us-east-1
# DOCUMENT_BUCKET=
# DYNAMODB_TABLE=
# PROCESSING_QUEUE_URL=
# CORS_ORIGIN=same-origin
# AWS workloads use IAM roles. Do not add AWS access keys to this file.
